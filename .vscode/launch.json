{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ADS: Diagnose source layout",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/de_generated_scripts/diagnose_pcell_parameters.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--lib",
        "${input:libraryName}",
        "--cell",
        "${input:cellName}",
        "--design",
        "${input:sourceView}",
        "--workspace",
        "${input:workspacePath}"
      ]
    },
    {
      "name": "ADS: Refresh RFPro view",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/de_generated_scripts/refresh_rfpro_view.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "args": [
        "--lib",
        "${input:libraryName}",
        "--cell",
        "${input:cellName}",
        "--design",
        "${input:rfproView}",
        "--workspace",
        "${input:workspacePath}"
      ]
    },
    {
      "name": "ADS DE: Attach on port 8765",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 8765
      },
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "workspacePath",
      "type": "promptString",
      "description": "Absolute path to the ADS workspace",
      "default": "/path/to/workspace_wrk"
    },
    {
      "id": "libraryName",
      "type": "promptString",
      "description": "Default ADS library",
      "default": "MY_LIB"
    },
    {
      "id": "cellName",
      "type": "promptString",
      "description": "Default ADS cell",
      "default": "MY_CELL"
    },
    {
      "id": "sourceView",
      "type": "promptString",
      "description": "Source layout view (or a longer identifier to override defaults)",
      "default": "layout"
    },
    {
      "id": "rfproView",
      "type": "promptString",
      "description": "RFPro view (or a longer identifier to override defaults)",
      "default": "MY_RFPRO_VIEW"
    }
  ]
}
